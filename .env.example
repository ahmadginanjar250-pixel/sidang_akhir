# ============================================================
#  ENVIRONMENT VARIABLES - Template untuk Deployment
#  Copy file ini menjadi .env dan isi nilainya
# ============================================================

# === DATABASE ===
# Supabase: ambil dari Project Settings > Database > URI
# Railway / Neon: ambil dari dashboard masing-masing
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# === NEXTAUTH ===
# NEXTAUTH_SECRET: generate dengan perintah: openssl rand -base64 32
NEXTAUTH_SECRET="isi-dengan-random-string-panjang-minimal-32-karakter"
# NEXTAUTH_URL: URL domain website Anda setelah deploy
NEXTAUTH_URL="https://nama-project-anda.vercel.app"

# === EMAIL / SMTP (Fitur Reset Password) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="email-anda@gmail.com"
# App Password Gmail: myaccount.google.com > Keamanan > Sandi Aplikasi
SMTP_PASS="xxxx xxxx xxxx xxxx"
